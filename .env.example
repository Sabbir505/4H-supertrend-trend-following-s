# ─── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── API Server ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001

# ─── Scanner Settings ───────────────────────────────────────────────────
TOP_N_COINS=100
MAX_SIGNALS_PER_SCAN=20
SCAN_TIMEFRAME=4h
CANDLE_FETCH_LIMIT=600
SIGNAL_COOLDOWN_HOURS=4

# ─── CoinGecko (optional) ──────────────────────────────────────────────
COINGECKO_API_KEY=

# ─── 4H Supertrend Trend-Ride Strategy ──────────────────────────────────
SUPERTREND_ATR_PERIOD=10
SUPERTREND_MULTIPLIER=3.5
EMA_FILTER_PERIOD=200
# ATR% band: symbols outside [min, max] are skipped on entry checks.
# NOTE: names must match config.py exactly (ATR_MIN_PCT, not MIN_ATR_PCT).
ATR_MIN_PCT=0.5
ATR_MAX_PCT=5.0
TRAIL_ATR_MULT=3.5
INITIAL_STOP_ATR_MULT=5.0
TIME_STOP_BARS=42
BREADTH_THRESHOLD=0.3
# Skip entries whose flip candle opens on Sunday (weekend liquidity edge).
SKIP_SUNDAY_ENTRIES=true
# No entries at all while breadth is below this floor (0 disables).
BREADTH_GATE=0.15
# Quality tiers to trade: A=confirmed longs, B=flush/high-breadth shorts,
# C=weak sets, D=BTC shorts. Comma-separated, or "all".
QUALITY_FILTER=A,B
# Symbols need at least this many closed candles (~EMA200 x3 warmup) to be
# scanned; younger listings are excluded from entries and breadth.
MIN_HISTORY_BARS=600

# ─── Portfolio risk caps ────────────────────────────────────────────────
MAX_OPEN_POSITIONS=15
# 0.5/0.25 (halved from 1.0/0.5 after 3-year validation: 3y max drawdown
# 75.5% → 41.9% at equal Sharpe — see backtest/REPORT.md §6f).
RISK_PCT_FULL=0.5
RISK_PCT_HALF=0.25

# ─── Live execution (Binance USDT-M futures) ────────────────────────────
# off = signal-only | dry = log orders, send nothing | live = real orders
# (live requires API keys with futures permissions; start in dry first).
EXECUTION_MODE=dry
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet: FUTURES_BASE_URL=https://testnet.binancefuture.com
FUTURES_BASE_URL=https://fapi.binance.com
# $1 margin x 5x = $5 notional per position (the exchange minimum on most
# pairs). Leverage is hard-capped at 5x; margin type is always ISOLATED.
EXECUTION_MARGIN_USDT=1.0
EXECUTION_LEVERAGE=5
EXECUTION_MAX_POSITIONS=15

# ─── Operations ─────────────────────────────────────────────────────────
# Alert when an open position's symbol stops appearing in the scan universe
# for this many days (delisted / fell out of top-100).
ORPHAN_ALERT_DAYS=3
# Parallel Binance kline fetches during a scan (weight-safe pool size).
FETCH_WORKERS=8

# ─── Extra exclusions (comma-separated) ─────────────────────────────────
# Pairs to skip in addition to the built-in list (config.py).
EXCLUDED_PAIRS=
