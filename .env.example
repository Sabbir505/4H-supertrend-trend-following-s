# ─── Telegram ───────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Bot Settings ────────────────────────────
TOP_N_COINS=100
MAX_SIGNALS_PER_SCAN=20

# ─── ATR Risk Multipliers (v4 strategy) ────────────────────
# SL distance from entry (in ATR multiples)
ATR_SL_MULTIPLIER=1.0

# TP distances as multiples of SL distance
ATR_TP1_MULTIPLIER=1.5
ATR_TP2_MULTIPLIER=2.0
ATR_TP3_MULTIPLIER=3.0
ATR_TP4_MULTIPLIER=4.0

# ─── TP Position Closing Percentages ────────────────────
# How much of position to close at each TP level (must sum to 100%)
TP1_CLOSE_PERCENT=40.0
TP2_CLOSE_PERCENT=30.0
TP3_CLOSE_PERCENT=20.0
TP4_CLOSE_PERCENT=10.0

# ─── Market Regime Settings ────────────────────
REGIME_EMA_FAST=21
REGIME_EMA_SLOW=55
REGIME_RSI_PERIOD=14
REGIME_RSI_THRESHOLD=50
