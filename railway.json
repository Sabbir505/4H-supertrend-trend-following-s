{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "python railway_server.py",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicy": {
      "maxRetries": 10,
      "window": 300
    }
  }
}
